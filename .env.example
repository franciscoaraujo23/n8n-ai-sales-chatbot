# Copiar para .env (que não vai para o git) e preencher.
# Os segredos de produção vivem nas credenciais do n8n, não aqui:
# este ficheiro só serve as ferramentas locais (build e evals).

# API do n8n (scripts/build.js, para enviar os workflows)
N8N_API_URL=https://<your-n8n-host>
N8N_API_KEY=

# Webhook do adaptador de eval e o valor do cabeçalho de autenticação
# (o mesmo da credencial "Eval chatbot" no n8n)
EVAL_WEBHOOK_URL=https://<your-n8n-host>/webhook/chatbot-eval
EVAL_HEADER_NAME=X-Eval-Token
EVAL_HEADER_VALUE=
